@{
    ViewData["Title"] = "Patient Feedback System";
}

<div class="container mt-5">

    <div class="text-center">

        <h1 class="display-4 fw-bold">
            Patient Feedback System
        </h1>

        <p class="lead mt-3">
            Welcome to the Patient Feedback System.
            Patients can submit feedback, while administrators can review reports and statistics.
        </p>

    </div>

    <div class="row justify-content-center mt-5">

        <div class="col-md-4 mb-3">

            <div class="card shadow">

                <div class="card-body text-center">

                    <h3>Patient</h3>

                    <p>
                        Login to submit and review your surveys.
                    </p>

                    <a asp-controller="Patient"
                       asp-action="Login"
                       class="btn btn-primary w-100">

                        Patient Login

                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-4 mb-3">

            <div class="card shadow">

                <div class="card-body text-center">

                    <h3>Administrator</h3>

                    <p>
                        Login to manage surveys, reports and statistics.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="Login"
                       class="btn btn-success w-100">

                        Admin Login

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>