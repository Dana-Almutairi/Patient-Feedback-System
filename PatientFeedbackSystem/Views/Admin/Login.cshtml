@model PatientFeedbackSystem.Models.Admin

<h2>Admin Login</h2>

<form asp-action="Login" method="post">

    <label>Email</label>
    <br />
    <input asp-for="Email" />
    <br />
    <br />

    <label>Password</label>
    <br />
    <input asp-for="Password" type="password" />
    <br />
    <br />

    <button type="submit">
        Login
    </button>

</form>

<br />

<span style="color:red">
    @ViewBag.Message
</span>