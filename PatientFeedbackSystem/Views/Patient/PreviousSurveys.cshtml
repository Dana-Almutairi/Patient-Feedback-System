@model List<PatientFeedbackSystem.Models.Survey>

<h2>Previous Surveys</h2>


@if (Model.Count == 0)
{
    <p>No surveys found.</p>
}

else
{

    <table border="1">

        <tr>

            <th>Date</th>
            <th>Overall Rate</th>
            <th>Status</th>

        </tr>


        @foreach (var item in Model)
        {
            <tr>

                <td>@item.DateSubmitted</td>

                <td>@item.OverallRate</td>

                <td>@item.Status</td>

            </tr>
        }


    </table>

}